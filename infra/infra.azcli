#!/bin/bash

# File to build OSR4Rights Webserver

# the ssh key I'm using is forced to be rsa
# see ~/ssh/config

# The VM clones main from GitHub, so only deploy when everything is committed and pushed
if [ -n "$(git status --porcelain)" ]; then
  echo "Uncommitted changes - commit and push first"
  exit 1
fi

git fetch origin main
if [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]; then
  echo "Local HEAD is not the same as origin/main - push (or pull) first"
  exit 1
fi

# the live Let's Encrypt cert, key and renewal config - reusing it avoids the
# duplicate certificate rate limit (5 per 7 days) when rebuilding often
# holds the private key, so it goes in secrets/ (git ignored) and is deleted once uploaded
live=dave@osr4rightstools.org
# ~/.ssh/config only maps the azure key to *.cloudapp.azure.com, so name it here
sshopts="-i ${HOME}/.ssh/id_rsa_azure -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
livecerts=../secrets/live-letsencrypt.tgz
if ! ssh ${sshopts} ${live} "sudo tar czf - -C /etc letsencrypt" > ${livecerts} \
   || ! gzip -t ${livecerts}; then
  echo "Could not copy the live certs - stopping"
  rm -f ${livecerts}
  exit 1
fi

set -x

# Ubuntu 26.04 LTS on Arm64 (the VM size below is Arm) - check with:
# az vm image list --publisher Canonical --offer ubuntu-26_04-lts --all --architecture Arm64 -o table
image=Canonical:ubuntu-26_04-lts:server-arm64:latest

# Generate a random suffix between 1 and 1000
int=$(shuf -i 1-1000 -n 1)

# If we are using passwords in the vm create below (default is to use SSH keys)
# Password must have the 3 of the following: 1 lower case character, 1 upper case character, 1 number and 1 special character
# generate a 34 character password (normal, capitals and numbers)
password=$(head /dev/urandom | tr -dc A-Za-z0-9 | head -c34)

rgprefix=osr4RightsTools
rg=${rgprefix}${int}

# Don't put capitals in dns name below and it needs to be unique (ie not used in azure at the moment)
dnsname=osr4rightstools${int}

# adminusername=dave
# adminpassword=${password}

region=westeurope
vmname=${dnsname}vm
vnet=vnet${int}
subnet=subnet${int}
publicIPName=publicIP${int}
nsgname=nsg${int}
nicName=nic${int}

# echo -e "az group delete --name ${rg} --no-wait --yes \n" > delCurrentRg.sh

# resource group
az group create \
   --name ${rg} \
   --location ${region}

# virtual network
az network vnet create \
    --resource-group ${rg} \
    --name ${vnet} \
    --subnet-name ${subnet}

# nework security group
az network nsg create \
    --resource-group ${rg} \
    --name ${nsgname}

# allow port 22 ssh (so that scp will work below)
az network nsg rule create \
    --resource-group ${rg} \
    --nsg-name ${nsgname} \
    --name nsgGroupRuleSSH22 \
    --protocol tcp \
    --priority 998 \
    --destination-port-range 22 \
    --access allow

# allow port 80
az network nsg rule create \
    --resource-group ${rg} \
    --nsg-name ${nsgname} \
    --name nsgGroupRuleWeb80 \
    --protocol tcp \
    --priority 1001 \
    --destination-port-range 80 \
    --access allow

# allow port 443
az network nsg rule create \
    --resource-group ${rg} \
    --nsg-name ${nsgname} \
    --name nsgGroupRuleWeb443 \
    --protocol tcp \
    --priority 1002 \
    --destination-port-range 443 \
    --access allow

# public IP and associate with the given DNS name
# Basic or Standard for the ip-sku
az network public-ip create \
    --resource-group ${rg} \
    --name ${publicIPName} \
    --sku Standard \
    --zone 1 \
    --dns-name ${dnsname}

# nic and associate with vnet, publicip
az network nic create \
    --resource-group ${rg} \
    --name ${nicName} \
    --vnet-name ${vnet} \
    --subnet ${subnet} \
    --public-ip-address ${publicIPName} \
    --network-security-group ${nsgname}

# Create vm which runs the cloud init script to provision 

# admin username defaults to my local username (dave)
az vm create \
    --resource-group ${rg} \
    --name ${vmname} \
    --location ${region} \
    --nics ${nicName} \
    --image ${image} \
    --ssh-key-values @~/.ssh/id_rsa_azure.pub \
    --storage-sku StandardSSD_LRS \
    --security-type Standard \
    --size Standard_B2pts_v2
    # B2pts_v2 doesn't support Trusted Launch, so the security type has to be Standard
    # West Europe pay-as-you-go prices Nov 2026. OS disk: Standard SSD E4 £1.80pm (Premium P4 was £4.37)
    # --size Standard_B2pts_v2 # £5.27pm (2 vCPU Arm, 1GB) - needs the swap in create_webserver.sh
    # --size Standard_B2pls_v2 # £21.08pm (2 vCPU Arm, 4GB) - next step up if 1GB struggles
    # --size Standard_B1s # £6.5pm (1 vCPU Intel, 1GB) - previous size, B-series v1, needs the x64 image

# creates /etc/systemd/system/kestrel-osr.service
az vm run-command invoke \
    -g ${rg} \
    -n ${vmname} \
    --command-id RunShellScript \
    --scripts @../secrets/create-kestrel-osr-with-secrets.sh

# copy dnsimple token (for certbot DNS-01 renewals) and the live certs to the VM
# create_webserver.sh moves them into /etc/letsencrypt and deletes these copies

# I have seen this timeout so retry until it works
# https://unix.stackexchange.com/questions/82598/how-do-i-write-a-retry-logic-in-script-to-keep-retrying-to-run-it-upto-5-times
n=0
until [ "$n" -ge 5 ]
do
   scp -o StrictHostKeyChecking=no ../secrets/dnsimpletoken.txt dave@${dnsname}.westeurope.cloudapp.azure.com:/home/dave/ \
     && scp -o StrictHostKeyChecking=no ${livecerts} dave@${dnsname}.westeurope.cloudapp.azure.com:/home/dave/live-letsencrypt.tgz && break
   n=$((n+1))
   sleep 15
done

# the cert copy holds the private key and is no use as a backup (a cert can always be reissued)
rm ${livecerts}

# gets .NET, clones source code, does a release build, starts systemd kestrel service
# systemd reads from file created on the vm above
# and sets environmental variables and starts kestrel webserver
az vm run-command invoke \
    -g ${rg} \
    -n ${vmname} \
    --command-id RunShellScript \
    --scripts @create_webserver.sh

# delete old resource groups
groupstodel=$(az group list --query "[?contains(name, '${rgprefix}')]".name --output tsv)

for rgtodel in $groupstodel
do
    if [ "$rgtodel" = "$rg" ]; then  
    echo "not deleting $rgtodel as have just created it"
    else
    # echo "dont delete for now"
	az group delete \
            --name $rgtodel \
            --no-wait \
            --yes
    fi
done

# generate dns here.. had trouble doing inside next if statement
generate_post_data()
{
  cat <<EOF
{
  "content": "${dnsname}.westeurope.cloudapp.azure.com",
  "ttl": 60
}
EOF
}

# stop echoing commands so the token isn't printed
set +x

# patch DNS through to the new VM only if the token file exist
filename=../secrets/dnsimpletoken.txt
if [ -f "$filename" ]; then
    echo "dnsimpletoken.txt file found"

    # get the first and only line
    token=$(head -n 1 $filename)

    # update DNS
    # osr4rightstools.org
    curl https://api.dnsimple.com/v2/63829/zones/osr4rightstools.org/records/25185791 -H "Authorization: Bearer ${token}" -H "Accept: application/json" -H "Content-Type: application/json" -X PATCH -d "$(generate_post_data)" 

    # www.osr4rightstools.org
    curl https://api.dnsimple.com/v2/63829/zones/osr4rightstools.org/records/25185798 -H "Authorization: Bearer ${token}" -H "Accept: application/json" -H "Content-Type: application/json" -X PATCH -d "$(generate_post_data)" 
fi


# to some degree we don't need this as am connecting using dns
# eg using ./osrSshCurrentVm.sh
echo -e "\nssh -o StrictHostKeyChecking=no dave@${dnsname}.westeurope.cloudapp.azure.com\n" > sshCurrentVm.sh

# echo -e "password is ${adminpassword}" > password.txt

echo -e "http://${dnsname}.westeurope.cloudapp.azure.com"
